## ============================================================
##  X86_64 私人固件 · 编译配置（基础部分）
##  源码：官方 immortalwrt/immortalwrt  (openwrt-25.12 分支)
##        packages/luci feed 换用 jjm2473 fork（iStoreOS 25.12 官方同款，
##        补回 lua 生态，解决 iStore 三件套被 defconfig 静默丢弃）
##  平台：x86_64 generic · 软件空间 4G (ROOTFS_PARTSIZE=4096)
##  LAN : 192.168.88.1
##
##  插件集：daed/lucky/easytier/argon/eqos/WireGuard/Tailscale...
##          + nikki/mihomo-meta + passwall(xray/sing-box)
##          + iStore 全家桶 + Docker
##  说明：写错的包名在 make defconfig 时会被自动忽略，不会导致编译失败
## ============================================================

## ---------- 目标平台 ----------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

## ---------- 软件空间 4G ----------
## x86 镜像的根分区大小，4G 足够 iStore 随便装
CONFIG_TARGET_ROOTFS_PARTSIZE=4096

## ---------- LuCI 界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-package-manager=y

## ---------- 主题（烤进固件，随便怎么刷都不会丢）----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

## ---------- iStore 全家桶（linkease 官方 feed）----------
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-linkease=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-unishare=y
CONFIG_PACKAGE_luci-nginxer=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y

## ---------- Docker ----------
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_cgroupfs-mount=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_tini=y

## ---------- EasyTier（P2P 异地组网）----------
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y

## ---------- Lucky 大吉（内网穿透 / DDNS / WebDAV / 反代）----------
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y

## ---------- WireGuard ----------
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

## ---------- Tailscale ----------
CONFIG_PACKAGE_tailscaled=y
CONFIG_PACKAGE_luci-app-tailscale=y

## ---------- mwan3 + 单线多拨（组件保留，账号不预置）----------
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-syncdial=y
CONFIG_PACKAGE_kmod-macvlan=y

## ---------- DDNS + 常用小工具 ----------
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-app-autoreboot=y

## ---------- 限速：EQoS（按设备上下行限速 + 白名单）----------
CONFIG_PACKAGE_luci-app-eqos=y
CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-sched=y

## ---------- 网络基础（有线，无无线模块）----------
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y

## ---------- 基础命令行工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_jq=y

## ---------- 中文语言包 ----------
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_luci-i18n-syncdial-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-filetransfer-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-eqos-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y

## ---------- Nikki（mihomo 内核透明代理；nikki feed 自带 mihomo 内核包）----------
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_mihomo-meta=y

## ---------- PassWall（xray / sing-box 双内核）----------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_geoview=y

## ---------- 不编译（显式关闭，避免被依赖带进来）----------
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-adbyby-plus is not set
# CONFIG_PACKAGE_luci-app-unblockmusic is not set
# CONFIG_PACKAGE_luci-app-serverchan is not set
# CONFIG_PACKAGE_luci-app-accesscontrol is not set
# CONFIG_PACKAGE_luci-app-guest-wifi is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_qosify is not set
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

## ---------- 瘦身黑名单（沿用 360T7 版教训；nikki/mihomo 已转正，仅排 clash 系重复壳）----------
# CONFIG_PACKAGE_mihomo-alpha is not set
# CONFIG_PACKAGE_mihomo is not set
# CONFIG_PACKAGE_clashoo is not set
# CONFIG_PACKAGE_luci-app-clashoo is not set
# CONFIG_PACKAGE_luci-i18n-clashoo-zh-cn is not set
# CONFIG_PACKAGE_momo is not set
# CONFIG_PACKAGE_luci-app-momo is not set
# CONFIG_PACKAGE_luci-app-fchomo is not set
